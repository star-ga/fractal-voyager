// main.mind - Fractal Voyager reference kernel
//
// A scalar, per-pixel reference of the kernel the browser demo runs on the GPU
// (the WGSL and GLSL shaders embedded in web/index.html). It covers:
//
//   - the view mapping from a pixel to a point c on the complex plane
//   - escape-time iteration for Mandelbrot, Julia, Burning Ship and Tricorn
//   - the O(1) main-cardioid / period-2-bulb test used to skip interior points
//   - the colour palettes that need no transcendental functions
//
// The program is its own test: `mindc run` executes a set of known-answer
// checks and the process exit code is the number of failed checks (0 = pass).
// The expected values were produced by an independent IEEE-754 double
// precision implementation of the same definitions.
//
// Precision note: this reference computes in f64; the shaders compute in f32.
// Escape counts therefore agree away from the set boundary and may differ for
// boundary pixels. The shaders also stop early when an orbit repeats exactly
// (periodicity check); that shortcut only fires for points that never escape,
// so it does not change any escape count and is not reproduced here.
//
// deferred: single file because mindc 0.10.2 cannot carry an f64 across a
// module boundary (an imported f64 signature miscompiles) - upgrade path: split
// into complex/fractal/color modules once a released mindc fixes that.
// deferred: the smooth (fractional) iteration count and the Neon, Psychedelic,
// Plasma and Galaxy palettes need log/sin, which live in std.detmath and hit
// the same cross-module limit - upgrade path: `import std.detmath;` then port
// them from the shader's getColor().
//
// Author: STARGA Inc. <noreply@star.ga>
// License: MIT

// ---------------------------------------------------------------------------
// Constants shared with the shaders
// ---------------------------------------------------------------------------

// Escape radius 256, squared. A large radius gives smoother colour gradients.
fn escape_radius_sq() -> f64 {
    return 65536.0;
}

// Default Julia constant used by the demo.
fn julia_re() -> f64 {
    return 0.0 - 0.7;
}

fn julia_im() -> f64 {
    return 0.27015;
}

// Fractal kinds, matching `fractalType` in the shaders.
fn kind_mandelbrot() -> i64 {
    return 0;
}

fn kind_julia() -> i64 {
    return 1;
}

fn kind_burning_ship() -> i64 {
    return 2;
}

fn kind_tricorn() -> i64 {
    return 3;
}

// ---------------------------------------------------------------------------
// Small scalar helpers
// ---------------------------------------------------------------------------

fn absf(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

fn minf(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    return b;
}

fn maxf(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    return b;
}

// Largest integer value not greater than x, as f64.
fn floorf(x: f64) -> f64 {
    let mut i: i64 = x as i64;
    if (i as f64) > x {
        i = i - 1;
    }
    return i as f64;
}

fn fractf(x: f64) -> f64 {
    return x - floorf(x);
}

// Square root by Newton's method, for x >= 0. Used only for 8-bit colour
// output, where it agrees with a correctly rounded sqrt.
fn sqrtf(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut y: f64 = maxf(x, 1.0);
    let mut i: i64 = 0;
    while i < 64 {
        y = 0.5 * (y + x / y);
        i = i + 1;
    }
    return y;
}

// ---------------------------------------------------------------------------
// View mapping
// ---------------------------------------------------------------------------
//
// The visible width of the complex plane is 3.5 / zoom along the vertical
// axis, scaled by the aspect ratio horizontally. Pixel (px, py) samples its
// centre; py counts from the bottom edge, as in the shaders' uv coordinates.

fn pixel_re(px: i64, width: i64, height: i64, center_re: f64, zoom: f64) -> f64 {
    let w: f64 = width as f64;
    let aspect: f64 = w / (height as f64);
    let scale: f64 = 3.5 / zoom;
    let u: f64 = ((px as f64) + 0.5) / w - 0.5;
    return center_re + u * scale * aspect;
}

fn pixel_im(py: i64, height: i64, center_im: f64, zoom: f64) -> f64 {
    let scale: f64 = 3.5 / zoom;
    let v: f64 = ((py as f64) + 0.5) / (height as f64) - 0.5;
    return center_im + v * scale;
}

// ---------------------------------------------------------------------------
// Escape-time iteration
// ---------------------------------------------------------------------------
//
// Each function returns the number of iterations before |z|^2 exceeds the
// escape radius, or max_iter when the orbit never escapes. The update order
// matches the shaders term for term.

// 1 when c lies in the main cardioid or the period-2 bulb, both of which are
// inside the Mandelbrot set; 0 otherwise.
fn in_cardioid_or_bulb(cr: f64, ci: f64) -> i64 {
    let xr: f64 = cr - 0.25;
    let q: f64 = xr * xr + ci * ci;
    if q * (q + xr) < 0.25 * ci * ci {
        return 1;
    }
    let br: f64 = cr + 1.0;
    if br * br + ci * ci < 0.0625 {
        return 1;
    }
    return 0;
}

// Mandelbrot: z <- z^2 + c, starting from z = 0.
pub fn mandelbrot_escape(cr: f64, ci: f64, max_iter: i64) -> i64 {
    if in_cardioid_or_bulb(cr, ci) == 1 {
        return max_iter;
    }
    let mut zr: f64 = 0.0;
    let mut zi: f64 = 0.0;
    let mut zr2: f64 = 0.0;
    let mut zi2: f64 = 0.0;
    let mut it: i64 = 0;
    while it < max_iter {
        if zr2 + zi2 > escape_radius_sq() {
            return it;
        }
        zi = 2.0 * zr * zi + ci;
        zr = zr2 - zi2 + cr;
        zr2 = zr * zr;
        zi2 = zi * zi;
        it = it + 1;
    }
    return it;
}

// Julia: z <- z^2 + k for a fixed constant k, starting from z = the pixel.
pub fn julia_escape(z0r: f64, z0i: f64, kr: f64, ki: f64, max_iter: i64) -> i64 {
    let mut zr: f64 = z0r;
    let mut zi: f64 = z0i;
    let mut zr2: f64 = zr * zr;
    let mut zi2: f64 = zi * zi;
    let mut it: i64 = 0;
    while it < max_iter {
        if zr2 + zi2 > escape_radius_sq() {
            return it;
        }
        let next_r: f64 = zr2 - zi2 + kr;
        zi = 2.0 * zr * zi + ki;
        zr = next_r;
        zr2 = zr * zr;
        zi2 = zi * zi;
        it = it + 1;
    }
    return it;
}

// Burning Ship: z <- (|Re z| + i|Im z|)^2 + c, starting from z = 0.
pub fn burning_ship_escape(cr: f64, ci: f64, max_iter: i64) -> i64 {
    let mut zr: f64 = 0.0;
    let mut zi: f64 = 0.0;
    let mut it: i64 = 0;
    while it < max_iter {
        let azr: f64 = absf(zr);
        let azi: f64 = absf(zi);
        if azr * azr + azi * azi > escape_radius_sq() {
            return it;
        }
        zr = azr * azr - azi * azi + cr;
        zi = 2.0 * azr * azi + ci;
        it = it + 1;
    }
    return it;
}

// Tricorn (Mandelbar): z <- conj(z)^2 + c, starting from z = 0.
pub fn tricorn_escape(cr: f64, ci: f64, max_iter: i64) -> i64 {
    let mut zr: f64 = 0.0;
    let mut zi: f64 = 0.0;
    let mut zr2: f64 = 0.0;
    let mut zi2: f64 = 0.0;
    let mut it: i64 = 0;
    while it < max_iter {
        if zr2 + zi2 > escape_radius_sq() {
            return it;
        }
        let next_r: f64 = zr2 - zi2 + cr;
        zi = -2.0 * zr * zi + ci;
        zr = next_r;
        zr2 = zr * zr;
        zi2 = zi * zi;
        it = it + 1;
    }
    return it;
}

// Dispatch on the fractal kind, as the fragment shader does.
pub fn escape_count(kind: i64, cr: f64, ci: f64, max_iter: i64) -> i64 {
    if kind == kind_mandelbrot() {
        return mandelbrot_escape(cr, ci, max_iter);
    }
    if kind == kind_julia() {
        return julia_escape(cr, ci, julia_re(), julia_im(), max_iter);
    }
    if kind == kind_burning_ship() {
        return burning_ship_escape(cr, ci, max_iter);
    }
    return tricorn_escape(cr, ci, max_iter);
}

// ---------------------------------------------------------------------------
// Frame statistics
// ---------------------------------------------------------------------------
//
// Renders a width x height frame and folds the escape counts into three
// numbers so a whole frame can be checked at once.

pub fn frame_total(kind: i64, width: i64, height: i64, center_re: f64, center_im: f64, zoom: f64, max_iter: i64) -> i64 {
    let mut total: i64 = 0;
    let mut py: i64 = 0;
    while py < height {
        let ci: f64 = pixel_im(py, height, center_im, zoom);
        let mut px: i64 = 0;
        while px < width {
            let cr: f64 = pixel_re(px, width, height, center_re, zoom);
            total = total + escape_count(kind, cr, ci, max_iter);
            px = px + 1;
        }
        py = py + 1;
    }
    return total;
}

// Position-weighted checksum: sum of count * (row-major index + 1), mod 1e9+7.
pub fn frame_weighted(kind: i64, width: i64, height: i64, center_re: f64, center_im: f64, zoom: f64, max_iter: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut idx: i64 = 0;
    let mut py: i64 = 0;
    while py < height {
        let ci: f64 = pixel_im(py, height, center_im, zoom);
        let mut px: i64 = 0;
        while px < width {
            let cr: f64 = pixel_re(px, width, height, center_re, zoom);
            idx = idx + 1;
            acc = (acc + escape_count(kind, cr, ci, max_iter) * idx) % 1000000007;
            px = px + 1;
        }
        py = py + 1;
    }
    return acc;
}

// Number of pixels that never escaped (drawn black by the demo).
pub fn frame_inside(kind: i64, width: i64, height: i64, center_re: f64, center_im: f64, zoom: f64, max_iter: i64) -> i64 {
    let mut inside: i64 = 0;
    let mut py: i64 = 0;
    while py < height {
        let ci: f64 = pixel_im(py, height, center_im, zoom);
        let mut px: i64 = 0;
        while px < width {
            let cr: f64 = pixel_re(px, width, height, center_re, zoom);
            if escape_count(kind, cr, ci, max_iter) >= max_iter {
                inside = inside + 1;
            }
            px = px + 1;
        }
        py = py + 1;
    }
    return inside;
}

// ---------------------------------------------------------------------------
// Colour
// ---------------------------------------------------------------------------
//
// Colours are returned packed as 0xRRGGBB with each channel clamped to [0, 1]
// and rounded to 8 bits, which is what the canvas stores.

fn channel8(x: f64) -> i64 {
    let c: f64 = minf(1.0, maxf(0.0, x));
    return (c * 255.0 + 0.5) as i64;
}

fn pack_rgb(r: f64, g: f64, b: f64) -> i64 {
    return channel8(r) * 65536 + channel8(g) * 256 + channel8(b);
}

// HSV to RGB, identical to the shaders' hsv2rgb().
pub fn hsv_to_rgb(h: f64, s: f64, v: f64) -> i64 {
    let c: f64 = v * s;
    let x: f64 = c * (1.0 - absf(fractf(h * 3.0) * 2.0 - 1.0));
    let m: f64 = v - c;
    let hi: i64 = (floorf(h * 6.0) as i64) % 6;
    if hi == 0 {
        return pack_rgb(c + m, x + m, m);
    }
    if hi == 1 {
        return pack_rgb(x + m, c + m, m);
    }
    if hi == 2 {
        return pack_rgb(m, c + m, x + m);
    }
    if hi == 3 {
        return pack_rgb(m, x + m, c + m);
    }
    if hi == 4 {
        return pack_rgb(x + m, m, c + m);
    }
    return pack_rgb(c + m, m, x + m);
}

// Palettes 0 (Electric), 1 (Fire), 2 (Ocean) and 4 (Grayscale).
// t is the normalised iteration count in [0, 1], time is in seconds and audio
// is the audio intensity in [0, 1]. Returns -1 for palettes not ported yet.
pub fn palette_rgb(scheme: i64, t: f64, time: f64, audio: f64) -> i64 {
    if scheme == 0 {
        return hsv_to_rgb(fractf(t * 5.0 + time * 0.1 + audio * 2.0), 0.8 + audio * 0.2, 0.9);
    }
    if scheme == 1 {
        let k: f64 = 1.0 + audio;
        let r: f64 = minf(1.0, t * 3.0) * k;
        let g: f64 = maxf(0.0, (t - 0.33) * 1.8) * k;
        let b: f64 = maxf(0.0, (t - 0.66) * 0.6) * k;
        return pack_rgb(r, g, b);
    }
    if scheme == 2 {
        return pack_rgb(t * 0.3, t * 0.6 + audio * 0.3, 0.4 + t * 0.6);
    }
    if scheme == 4 {
        let v: f64 = sqrtf(t);
        return pack_rgb(v, v, v);
    }
    return -1;
}

// ---------------------------------------------------------------------------
// Known-answer checks
// ---------------------------------------------------------------------------

// 0 when got == want, 1 otherwise (printing the mismatch).
fn check(got: i64, want: i64) -> i64 {
    if got == want {
        return 0;
    }
    print(got);
    print(want);
    return 1;
}

fn check_points() -> i64 {
    let mut fails: i64 = 0;
    // The cardioid / bulb test itself (it only skips work, so the escape
    // counts below cannot detect a broken test on their own).
    fails = fails + check(in_cardioid_or_bulb(0.0, 0.0), 1);
    fails = fails + check(in_cardioid_or_bulb(0.0 - 1.0, 0.0), 1);
    fails = fails + check(in_cardioid_or_bulb(0.0 - 0.1, 0.6), 1);
    fails = fails + check(in_cardioid_or_bulb(0.3, 0.5), 0);
    fails = fails + check(in_cardioid_or_bulb(0.0 - 1.3, 0.0), 0);
    // Interior points answered by the cardioid / bulb test.
    fails = fails + check(mandelbrot_escape(0.0, 0.0, 100), 100);
    fails = fails + check(mandelbrot_escape(0.0 - 1.0, 0.0, 100), 100);
    // Points that escape after a known number of iterations.
    fails = fails + check(mandelbrot_escape(1.0, 0.0, 100), 5);
    fails = fails + check(mandelbrot_escape(0.0 - 0.75, 0.1, 100), 36);
    fails = fails + check(mandelbrot_escape(0.3, 0.5, 100), 100);
    fails = fails + check(julia_escape(0.0, 0.0, julia_re(), julia_im(), 100), 98);
    fails = fails + check(burning_ship_escape(0.0 - 1.75, 0.0 - 0.03, 100), 26);
    fails = fails + check(tricorn_escape(0.5, 0.5, 100), 10);
    return fails;
}

// One frame of 48 x 27 pixels at the demo's reset view (centre -0.5 + 0i).
fn check_frame(kind: i64, zoom: f64, max_iter: i64, total: i64, weighted: i64, inside: i64) -> i64 {
    let mut fails: i64 = 0;
    fails = fails + check(frame_total(kind, 48, 27, 0.0 - 0.5, 0.0, zoom, max_iter), total);
    fails = fails + check(frame_weighted(kind, 48, 27, 0.0 - 0.5, 0.0, zoom, max_iter), weighted);
    fails = fails + check(frame_inside(kind, 48, 27, 0.0 - 0.5, 0.0, zoom, max_iter), inside);
    return fails;
}

fn check_frames() -> i64 {
    let mut fails: i64 = 0;
    // Zoom 1 uses the demo's base budget of 100 iterations.
    fails = fails + check_frame(kind_mandelbrot(), 1.0, 100, 16104, 10452545, 96);
    fails = fails + check_frame(kind_julia(), 1.0, 100, 14863, 9691159, 82);
    fails = fails + check_frame(kind_burning_ship(), 1.0, 100, 17894, 9777691, 112);
    fails = fails + check_frame(kind_tricorn(), 1.0, 100, 11808, 7677319, 52);
    // Zoom 2 gives floor(100 + log2(2) * 30) = 130 iterations, which is not a
    // multiple of 4, so it also covers the shaders' remainder iterations.
    fails = fails + check_frame(kind_mandelbrot(), 2.0, 130, 57694, 37536702, 371);
    fails = fails + check_frame(kind_julia(), 2.0, 130, 51325, 33989541, 272);
    fails = fails + check_frame(kind_burning_ship(), 2.0, 130, 57477, 26441921, 379);
    fails = fails + check_frame(kind_tricorn(), 2.0, 130, 31242, 20388638, 167);
    return fails;
}

fn check_palettes() -> i64 {
    let mut fails: i64 = 0;
    fails = fails + check(palette_rgb(0, 0.37, 2.5, 0.25), 2257126);
    fails = fails + check(palette_rgb(0, 0.81, 0.0, 0.0), 15099182);
    fails = fails + check(palette_rgb(1, 0.37, 2.5, 0.25), 16717568);
    fails = fails + check(palette_rgb(1, 0.81, 0.0, 0.0), 16768023);
    fails = fails + check(palette_rgb(2, 0.37, 2.5, 0.25), 1854623);
    fails = fails + check(palette_rgb(2, 0.81, 0.0, 0.0), 4095202);
    fails = fails + check(palette_rgb(4, 0.37, 2.5, 0.25), 10197915);
    fails = fails + check(palette_rgb(4, 0.81, 0.0, 0.0), 15132390);
    return fails;
}

// Exit code = number of failed checks; 0 means every check passed.
fn main() -> i64 {
    let fails: i64 = check_points() + check_frames() + check_palettes();
    print(fails);
    return fails;
}
